# Grocery Agent Configuration
# Copy this file to .env and customize for your environment
# This file should NOT be committed to git

# ============ Environment ============
# Options: development, production, testing
ENV=development

# ============ LLM Model Settings ============
# Path to the GGUF model file
MODEL_PATH=./models/llama-3-8b-instruct.gguf

# Context window size (max tokens the model can see)
LLM_N_CTX=2048

# Number of threads for model inference
LLM_N_THREADS=4

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.0

# Maximum tokens to generate per response
LLM_MAX_TOKENS=1024

# ============ Data Storage ============
# Path to pantry data file
PANTRY_FILE=data/pantry.json

# Path to conversation memory file
MEMORY_FILE=memory/conversation.json

# ============ Logging ============
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
